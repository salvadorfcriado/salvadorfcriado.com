---
import { SITE } from '../consts';
const { entity } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap inner">
    <p class="entity">{entity}</p>
    <div class="right">
      <nav class="elsewhere" aria-label="Elsewhere">
        <a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
        <a href={SITE.github} rel="me noopener" target="_blank">GitHub</a>
        <a href={`mailto:${SITE.email}`}>Email</a>
      </nav>
      <span class="copy">© {year} salvadorfcriado.com</span>
    </div>
  </div>
</footer>

<style>
  .foot { border-top: 1px solid var(--border); }
  .inner {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: var(--space-gap-lg);
    padding: 22px var(--space-section-x);
  }
  .entity {
    font-size: var(--text-meta); line-height: 1.6;
    color: var(--text-muted); max-width: 700px;
  }
  .right { display: flex; align-items: baseline; gap: var(--space-gap-lg); white-space: nowrap; }
  .elsewhere { display: flex; gap: var(--space-gap); }
  .elsewhere a, .copy {
    font-family: var(--font-mono); font-size: var(--text-meta);
    letter-spacing: 0.04em; color: var(--text-muted);
  }
  .elsewhere a:hover { color: var(--accent); }
  @media (max-width: 860px) {
    .inner { flex-direction: column; gap: var(--space-gap); }
    .right { flex-wrap: wrap; white-space: normal; gap: var(--space-gap); }
  }
</style>
