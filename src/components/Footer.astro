---
import Icon from './Icon.astro';
import { SITE } from '../consts';
import { copy } from '../i18n/site';
import { route, serviceRoute, SERVICE_IDS, dossierPdf } from '../i18n/routes';
import { UI, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = copy(lang);
const ui = UI[lang];
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="inner">
    <div class="top">
      <div class="brand-col">
        <a class="brand" href={route(lang, 'home')}>
          <span class="mark" aria-hidden="true">SC</span>
          <span>{SITE.name}</span>
        </a>
        <p class="tagline">{c.footer.tagline}</p>
        <a class="email" href={`mailto:${SITE.email}`}><Icon name="mail" size={18} />{SITE.email}</a>
        <p class="status"><span class="pill-dot" aria-hidden="true"></span>{c.home.hero.badge}</p>
      </div>

      <nav class="col" aria-label={c.footer.servicesCol}>
        <p class="col-title">{c.footer.servicesCol}</p>
        <ul role="list">
          {SERVICE_IDS.map((id) => (
            <li><a href={serviceRoute(lang, id)}>{c.services.items.find((s) => s.id === id)!.name}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="col" aria-label={c.footer.companyCol}>
        <p class="col-title">{c.footer.companyCol}</p>
        <ul role="list">
          <li><a href={route(lang, 'work')}>{c.nav.work}</a></li>
          <li><a href={route(lang, 'about')}>{c.nav.about}</a></li>
          <li><a href={route(lang, 'cv')}>{c.nav.cv}</a></li>
          <li><a href={route(lang, 'contact')}>{c.nav.contact}</a></li>
          <li><a href={route(lang, 'dossier')}>Dossier</a></li>
        </ul>
      </nav>

      <nav class="col" aria-label={c.footer.resourcesCol}>
        <p class="col-title">{c.footer.resourcesCol}</p>
        <ul role="list">
          <li><a href={route(lang, 'blog')}>{c.nav.blog}</a></li>
          <li><a href={dossierPdf(lang)} download>{c.common.downloadDossier}</a></li>
          <li><a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn<span class="sr-only">{ui.newTab}</span></a></li>
          <li><a href={SITE.github} rel="me noopener" target="_blank">GitHub<span class="sr-only">{ui.newTab}</span></a></li>
          <li><a href={lang === 'es' ? '/es/rss.xml' : '/rss.xml'}>{c.footer.rss}</a></li>
        </ul>
      </nav>
    </div>

    <div class="bottom">
      <p>© {year} {SITE.name}. {c.footer.rights}</p>
      <p class="entity">{ui.entity}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--dark); color: var(--on-dark-muted);
    padding: 72px var(--gutter) 32px; border-top: 1px solid var(--dark-border);
  }
  .inner { max-width: var(--container); margin: 0 auto; }
  .top { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 48px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; color: #fff; font-family: var(--font-display); font-weight: 650; font-size: 1.125rem; }
  .mark {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 10px;
    background: linear-gradient(135deg, #8b7bff, var(--accent) 55%, #4b3bc4);
    color: #fff; font-size: 0.8125rem; font-weight: 700;
  }
  .tagline { margin-top: 16px; font-size: var(--fs-sm); max-width: 30em; line-height: 1.6; }
  .email { display: inline-flex; align-items: center; gap: 10px; margin-top: 22px; color: #fff; font-weight: 500; }
  .email:hover, .email:focus-visible { color: #c2b8ff; }
  .status { display: flex; align-items: center; gap: 10px; margin-top: 14px; font-size: var(--fs-xs); }
  .col-title { color: #fff; font-weight: 600; font-size: var(--fs-sm); margin-bottom: 14px; }
  .col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .col a { font-size: var(--fs-sm); }
  .col a:hover, .col a:focus-visible { color: #fff; }
  .bottom {
    margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--dark-border);
    display: flex; justify-content: space-between; gap: 32px; font-size: var(--fs-xs);
  }
  .entity { max-width: 60ch; text-align: right; opacity: 0.75; }
  @media (max-width: 900px) {
    .top { grid-template-columns: 1fr 1fr; }
    .brand-col { grid-column: 1 / -1; }
    .bottom { flex-direction: column; gap: 10px; }
    .entity { text-align: left; }
  }
  @media (max-width: 480px) {
    .top { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
