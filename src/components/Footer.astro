---
import { SITE } from '../consts';

interface Props {
  entity: string;
}

const { entity } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap inner">
    <div>
      <p class="entity">{entity}</p>
      <p class="status">{SITE.status}</p>
    </div>
    <div class="right">
      <nav class="elsewhere" aria-label="Elsewhere">
        <a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
        <a href={SITE.github} rel="me noopener" target="_blank">GitHub<span class="sr-only"> (opens in a new tab)</span></a>
        <a href={`mailto:${SITE.email}`}>Email</a>
      </nav>
      <span class="copy">© {year} {SITE.domain}</span>
    </div>
  </div>
</footer>

<style>
  .foot { border-top: 1px solid var(--border); padding: 0 var(--space-section-x); }
  .inner {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: var(--space-gap-lg);
    padding: 22px 0;
  }
  .entity {
    font-size: var(--text-meta); line-height: 1.6;
    color: var(--text-muted); max-width: 60ch;
  }
  /* The availability line appears on every post too, which is where a reader
     arriving from search is warmest. */
  .status {
    font-family: var(--font-mono); font-size: var(--text-meta);
    letter-spacing: var(--tracking-wide); color: var(--accent); margin-top: 6px;
  }
  .right { display: flex; align-items: baseline; gap: var(--space-gap-lg); white-space: nowrap; }
  .elsewhere { display: flex; gap: var(--space-gap); }
  .elsewhere a, .copy {
    font-family: var(--font-mono); font-size: var(--text-meta);
    letter-spacing: var(--tracking-wide); color: var(--text-muted);
  }
  .elsewhere a:hover, .elsewhere a:focus-visible { color: var(--accent); }
  @media (max-width: 860px) {
    .inner { flex-direction: column; gap: var(--space-gap); }
    .right { flex-wrap: wrap; white-space: normal; gap: var(--space-gap); }
  }
  @media (max-width: 760px) {
    .elsewhere a { display: inline-flex; align-items: center; min-height: 44px; }
  }
</style>
