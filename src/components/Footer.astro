---
const { entity } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap inner">
    <p class="entity">{entity}</p>
    <span class="copy">© {year} salvadorfcriado.com</span>
  </div>
</footer>

<style>
  .foot { border-top: 1px solid var(--border); }
  .inner {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: var(--space-gap-lg);
    padding: 22px var(--space-section-x);
  }
  .entity {
    font-size: var(--text-meta); line-height: 1.6;
    color: var(--text-muted); max-width: 700px;
  }
  .copy {
    font-family: var(--font-mono); font-size: var(--text-meta);
    color: var(--text-muted); white-space: nowrap;
  }
  @media (max-width: 760px) {
    .inner { flex-direction: column; gap: var(--space-gap); }
  }
</style>
