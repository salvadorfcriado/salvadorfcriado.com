---
/* Topic chips. Plain links to prerendered archives — no JavaScript, so they
   work for a crawler and for a reader with scripting off, and every topic has a
   URL that can be cited. `current` marks the archive you are already on. */
import { tagLabel } from '../tags';

interface Props {
  tags: readonly string[];
  current?: string;
  /* 'row' on index/archive pages, 'inline' in a post header. */
  variant?: 'row' | 'inline';
}

const { tags, current, variant = 'row' } = Astro.props;
---
{/* role="list" — WebKit drops list semantics when list-style is none. */}
<ul class:list={['chips', variant]} role="list">
  {tags.map((slug) => (
    <li>
      <a
        class:list={['chip', { active: slug === current }]}
        href={`/blog/tags/${slug}/`}
        aria-current={slug === current ? 'page' : undefined}
      >{tagLabel(slug)}</a>
    </li>
  ))}
</ul>

<style>
  .chips {
    display: flex; flex-wrap: wrap; gap: var(--space-gap-sm);
    list-style: none; margin: 0; padding: 0;
  }
  /* The .chip base lives in global.css — it was restated in three places. */
  .chip:hover, .chip:focus-visible {
    color: var(--accent-strong); border-color: var(--accent); background: var(--accent-soft);
  }
  .chip.active {
    color: var(--on-accent);
    background: var(--accent);
    border-color: var(--accent);
  }
  .chip.active:hover, .chip.active:focus-visible {
    background: var(--accent-strong); border-color: var(--accent-strong); color: var(--on-accent);
  }
  .inline .chip { font-size: var(--text-meta); padding: 4px 8px; }
</style>
