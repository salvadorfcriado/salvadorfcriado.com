---
/* The full range of what Salvador takes on, in three groups, closed by an
   open-ended "your case doesn't fit a box?" card. Used on home and services. */
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import type { SiteCopy } from '../i18n/site';

interface Props {
  c: SiteCopy['capabilities'];
  contactHref: string;
  surface?: boolean;
}

const { c, contactHref, surface = false } = Astro.props;
---
<section class:list={['section', { 'section--surface': surface }]} id="capabilities">
  <div class="container">
    <SectionHeader eyebrow={c.eyebrow} title={c.title} lead={c.lead} />
    <div class="groups">
      {c.groups.map((g, gi) => (
        <div class:list={['group', 'reveal', `g${gi}`]} data-delay={String(gi)}>
          <div class="g-head">
            <span class="g-n" aria-hidden="true">{String(gi + 1).padStart(2, '0')}</span>
            <div>
              <h3>{g.t}</h3>
              <p>{g.d}</p>
            </div>
          </div>
          <ul class="items" role="list">
            {g.items.map((it) => (
              <li>
                <span class="i-icon"><Icon name={it.icon} size={20} /></span>
                <span><strong>{it.t}</strong><span class="i-d">{it.d}</span></span>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="custom reveal" data-delay="3">
        <h3>{c.custom.t}</h3>
        <p>{c.custom.d}</p>
        <a class="btn btn-white" href={contactHref}>{c.custom.cta}<Icon name="arrow" /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .groups { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; align-items: stretch; }
  .group { padding: 28px; border-radius: var(--radius-card); background: var(--bg); border: 1px solid var(--border); box-shadow: var(--shadow-sm); }
  .g0 { border-top: 3px solid var(--accent); }
  .g1 { border-top: 3px solid #8f6dff; }
  .g2 { border-top: 3px solid #3aa7f0; grid-column: 1 / -1; }
  .g-head { display: flex; gap: 16px; align-items: baseline; padding-bottom: 18px; border-bottom: 1px solid var(--border); }
  .g-n { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--accent); }
  .g-head h3 { font-size: var(--fs-h3); font-weight: 650; }
  .g-head p { font-size: var(--fs-sm); color: var(--text-muted); margin-top: 2px; }
  .items { list-style: none; display: grid; gap: 4px; margin-top: 12px; }
  .g2 .items { grid-template-columns: repeat(3, 1fr); column-gap: 24px; }
  .items li { display: flex; gap: 14px; align-items: flex-start; padding: 12px 0; }
  .i-icon {
    flex: none; display: inline-flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; border-radius: 11px; background: var(--accent-soft); color: var(--accent);
  }
  .items strong { display: block; color: var(--ink); font-weight: 600; font-size: var(--fs-sm); }
  .i-d { display: block; font-size: var(--fs-xs); line-height: 1.5; color: var(--text-muted); margin-top: 2px; }
  .custom {
    grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1.6fr auto; gap: 32px; align-items: center;
    padding: 32px 36px; border-radius: var(--radius-card); color: var(--on-dark-muted);
    background: radial-gradient(120% 140% at 100% 0%, rgba(139, 123, 255, 0.5), transparent 55%), var(--dark);
  }
  .custom h3 { color: #fff; font-size: var(--fs-h3); font-weight: 650; }
  .custom p { font-size: var(--fs-sm); }
  @media (max-width: 960px) {
    .groups { grid-template-columns: 1fr; }
    .g2 .items { grid-template-columns: 1fr 1fr; }
    .custom { grid-template-columns: 1fr; gap: 14px; }
    .custom .btn { justify-self: start; }
  }
  @media (max-width: 600px) {
    .g2 .items { grid-template-columns: 1fr; }
    .group { padding: 22px; }
  }
</style>
