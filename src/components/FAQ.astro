---
/* Accordion on <details>: keyboard and screen-reader support for free, no JS. */
import type { QA } from '../i18n/site/types';

interface Props {
  items: QA[];
}

const { items } = Astro.props;
---
<div class="faq">
  {items.map((it, i) => (
    <details class="qa reveal" data-delay={String(Math.min(i, 4))}>
      <summary>
        <span>{it.q}</span>
        <span class="toggle" aria-hidden="true"></span>
      </summary>
      <p>{it.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { display: flex; flex-direction: column; gap: 12px; }
  .qa { border: 1px solid var(--border); border-radius: 16px; background: var(--bg); transition: border-color 200ms, box-shadow 200ms; }
  .qa[open] { border-color: var(--accent-line); box-shadow: var(--shadow-md); }
  summary {
    list-style: none; cursor: pointer;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 20px 24px; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-h4); color: var(--ink);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--accent-strong); }
  .toggle { position: relative; flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--surface); }
  .toggle::before, .toggle::after {
    content: ''; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; margin: -1px 0 0 -6px;
    background: var(--accent); border-radius: 2px; transition: transform 200ms var(--ease);
  }
  .toggle::after { transform: rotate(90deg); }
  .qa[open] .toggle::after { transform: rotate(0deg); }
  .qa p { padding: 0 24px 22px; max-width: 46em; }
</style>
