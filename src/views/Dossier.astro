---
/* The services dossier as five A4 sheets. On screen it reads as a document
   preview; printed (or rendered by scripts/dossier-pdf.mjs) each .sheet is one
   page. Everything comes from the same copy as the site, so the PDF can never
   say something the site does not. Every link is a real <a> with an absolute
   URL, so it stays clickable in the PDF. */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../consts';
import { copy, SERVICE_ICON } from '../i18n/site';
import { route, serviceRoute, dossierPdf } from '../i18n/routes';
import { otherLang, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = copy(lang);
const d = c.dossier;
const host = SITE.domain;
const abs = (p: string) => `${SITE.url}${p}`;
const TOTAL = 5;
const [bigA, bigB, ...small] = c.home.stats;
---
<Base
  title={d.meta.title}
  titleSuffix={false}
  description={d.meta.description}
  path={route(lang, 'dossier')}
  altPath={route(otherLang(lang), 'dossier')}
  lang={lang}
>
  <div class="toolbar no-print">
    <div class="container tb">
      <p>{d.kicker}</p>
      <div class="tb-actions">
        <button class="btn btn-secondary" type="button" onclick="window.print()"><Icon name="printer" />{d.print}</button>
        <a class="btn btn-primary" href={dossierPdf(lang)} download><Icon name="download" />{d.download}</a>
      </div>
    </div>
  </div>

  <div class="doc">
    <!-- 1 · Cover ─────────────────────────────────────────────────────── -->
    <section class="sheet cover">
      <div class="cover-grid" aria-hidden="true"></div>
      <header class="cover-top">
        <a class="brand" href={abs(route(lang, 'home'))}><span class="mark">SC</span>{SITE.name}</a>
        <span class="cover-tag">{d.kicker}</span>
      </header>

      <div class="cover-main">
        <p class="kicker">{c.nav.servicesIntro}</p>
        <h1>{d.title}</h1>
        <p class="cover-sub">{c.home.hero.lead}</p>
      </div>

      <dl class="bento">
        {[bigA, bigB].map((s) => (
          <div class="b-big"><dt>{s.l}</dt><dd>{s.n}</dd></div>
        ))}
        {small.map((s) => (
          <div class="b-small"><dt>{s.l}</dt><dd>{s.n}</dd></div>
        ))}
      </dl>

      <footer class="cover-foot">
        <a href={`mailto:${SITE.email}`}><Icon name="mail" size={13} />{SITE.email}</a>
        <a href={abs(route(lang, 'home'))}><Icon name="globe" size={13} />{host}</a>
        <a href={SITE.linkedin}><Icon name="linkedin" size={13} />linkedin.com/in/salvadorfcriado</a>
      </footer>
    </section>

    <!-- 2 · Capabilities ──────────────────────────────────────────────── -->
    <section class="sheet">
      <header class="ph">
        <span class="ph-n">01</span>
        <h2>{c.capabilities.eyebrow}</h2>
        <a class="ph-brand" href={abs(route(lang, 'home'))}><span class="mark sm">SC</span>{SITE.name}</a>
      </header>
      <p class="lead-title">{c.capabilities.title}</p>
      <p class="lead">{c.capabilities.lead}</p>

      <div class="cap-groups">
        {c.capabilities.groups.map((g, gi) => (
          <div class:list={['cap-group', `cg${gi}`]}>
            <h3>{g.t}<span>{g.d}</span></h3>
            <ul>
              {g.items.map((it) => (
                <li><span class="cap-icon"><Icon name={it.icon} size={13} /></span><span><strong>{it.t}</strong>{it.d}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <p class="sub-h">{c.home.sectors.title}</p>
      <div class="sectors">
        {c.home.sectors.items.map((x) => <div><strong>{x.t}</strong>{x.d}</div>)}
      </div>

      <p class="note"><strong>{c.capabilities.custom.t}</strong> {c.capabilities.custom.d}</p>

      <footer class="pf">
        <a href={abs(route(lang, 'home'))}>{host}</a>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <span>2 / {TOTAL}</span>
      </footer>
    </section>

    <!-- 3 · Services ──────────────────────────────────────────────────── -->
    <section class="sheet">
      <header class="ph">
        <span class="ph-n">02</span>
        <h2>{d.sections.services}</h2>
        <a class="ph-brand" href={abs(route(lang, 'home'))}><span class="mark sm">SC</span>{SITE.name}</a>
      </header>
      <p class="lead">{c.home.services.lead}</p>
      <div class="svc-grid">
        {c.services.items.map((s) => (
          <article class="svc">
            <img src={`/video/${s.id}-${lang}.webp`} width="1200" height="800" alt="" />
            <div class="svc-body">
              <p class="svc-k"><Icon name={SERVICE_ICON[s.id]} size={12} />{s.name}</p>
              <h3>{s.title}</h3>
              <p class="svc-t">{s.tagline}</p>
              <ul>{s.outcomes.slice(0, 2).map((o) => <li>{o}</li>)}</ul>
              <p class="more-row">
                <a class="more" href={abs(serviceRoute(lang, s.id))}>{c.common.viewService} →</a>
                {s.live && <a class="more live" href={s.live.href}>{s.live.label} ↗</a>}
              </p>
            </div>
          </article>
        ))}
      </div>
      <footer class="pf">
        <a href={abs(route(lang, 'services'))}>{host}{route(lang, 'services')}</a>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <span>3 / {TOTAL}</span>
      </footer>
    </section>

    <!-- 4 · Work ──────────────────────────────────────────────────────── -->
    <section class="sheet">
      <header class="ph">
        <span class="ph-n">03</span>
        <h2>{d.sections.work}</h2>
        <a class="ph-brand" href={abs(route(lang, 'home'))}><span class="mark sm">SC</span>{SITE.name}</a>
      </header>
      <p class="lead">{c.work.hero.lead} {c.work.note}</p>
      <div class="cases">
        {c.work.items.map((k) => (
          <article class="case">
            <div class="case-top">
              <p class="case-metric">{k.metric}</p>
              <p class="case-label">{k.metricLabel}</p>
            </div>
            <p class="case-sector">{k.sector}</p>
            <h3>{k.title}</h3>
            <p class="case-body">{k.summary}</p>
            <p class="case-result"><strong>{c.common.result}:</strong> {k.result}</p>
            {k.link && <a class="case-link" href={k.link.href}>{k.link.label} ↗</a>}
          </article>
        ))}
      </div>
      <footer class="pf">
        <a href={abs(route(lang, 'work'))}>{host}{route(lang, 'work')}</a>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <span>4 / {TOTAL}</span>
      </footer>
    </section>

    <!-- 5 · Process, approach, about, contact ─────────────────────────── -->
    <section class="sheet">
      <header class="ph">
        <span class="ph-n">04</span>
        <h2>{d.sections.process}</h2>
        <a class="ph-brand" href={abs(route(lang, 'home'))}><span class="mark sm">SC</span>{SITE.name}</a>
      </header>
      <ol class="process">
        {c.home.process.steps.map((s, i) => (
          <li><span class="p-n">{String(i + 1).padStart(2, '0')}</span><span class="p-when">{s.when}</span><h3>{s.t}</h3><p>{s.d}</p></li>
        ))}
      </ol>

      <div class="why">
        <div>
          <p class="k">{c.home.why.eyebrow}</p>
          <h3>{c.home.why.title}</h3>
          <p>{c.home.why.lead}</p>
        </div>
        <ul>{c.home.why.items.map((w) => <li><strong>{w.t}</strong>{w.d}</li>)}</ul>
      </div>

      <p class="sub-h">{c.home.approach.title}</p>
      <div class="approach">
        {c.home.approach.levels.map((l, i) => (
          <div class:list={['ap', { dark: i === 2 }]}>
            <p class="ap-tag">{String(i + 1).padStart(2, '0')} · {l.tag}</p>
            <h3>{l.t}</h3>
            <p>{l.when}</p>
            <p class="ap-tools">{l.tools}</p>
          </div>
        ))}
      </div>

      <p class="sub-h">{d.sections.about}</p>
      <div class="about">
        <img src="/img/portrait-390.webp" width="390" height="460" alt="" />
        <div>
          <p class="about-lead">{c.about.hero.lead}</p>
          <ul class="creds">
            {c.about.credentials.items.map((x) => <li><span>{x.k}</span>{x.v}</li>)}
          </ul>
        </div>
      </div>

      <div class="contact">
        <div>
          <p class="k">{d.sections.contact}</p>
          <h3>{c.cta.title}</h3>
          <p>{d.contactLead}</p>
        </div>
        <ul>
          <li><a href={`mailto:${SITE.email}`}><Icon name="mail" size={15} />{SITE.email}</a></li>
          <li><a href={abs(route(lang, 'contact'))}><Icon name="globe" size={15} />{host}{route(lang, 'contact')}</a></li>
          <li><a href={SITE.linkedin}><Icon name="linkedin" size={15} />linkedin.com/in/salvadorfcriado</a></li>
        </ul>
      </div>

      <footer class="pf">
        <a href={abs(route(lang, 'cv'))}>{host}{route(lang, 'cv')}</a>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <span>5 / {TOTAL}</span>
      </footer>
    </section>
  </div>
</Base>

<style>
  /* ── Screen chrome ─────────────────────────────────────────────────── */
  .toolbar { position: sticky; top: 68px; z-index: 10; background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
  .tb { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 12px; }
  .tb p { font-weight: 600; color: var(--ink); }
  .tb-actions { display: flex; gap: 10px; }
  .tb .btn { min-height: 42px; }
  @media (max-width: 600px) {
    .tb p { display: none; }
    .tb-actions { width: 100%; }
    .tb .btn { flex: 1; padding: 0 12px; }
  }
  .doc { background: var(--surface-2); padding: 40px 16px 80px; display: flex; flex-direction: column; align-items: center; gap: 32px; }

  /* ── Sheet ─────────────────────────────────────────────────────────── */
  .sheet {
    width: 210mm; height: 297mm; overflow: hidden; position: relative;
    background: #fff; box-shadow: var(--shadow-lg); padding: 13mm 15mm 11mm;
    display: flex; flex-direction: column; font-size: 9pt; line-height: 1.5; color: var(--text);
  }
  .sheet a { color: inherit; }
  .mark {
    display: inline-flex; align-items: center; justify-content: center; flex: none;
    width: 30px; height: 30px; border-radius: 9px;
    background: linear-gradient(135deg, #8b7bff, var(--accent) 55%, #4b3bc4);
    color: #fff; font-family: var(--font-display); font-size: 8.5pt; font-weight: 700;
  }
  .mark.sm { width: 20px; height: 20px; border-radius: 6px; font-size: 6.5pt; }

  /* Page header and footer */
  .ph { display: flex; align-items: center; gap: 12px; padding-bottom: 9px; margin-bottom: 12px; border-bottom: 1px solid var(--border); }
  .ph-n {
    display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 8px;
    background: var(--accent-soft); border: 1px solid var(--accent-line); color: var(--accent);
    font-family: var(--font-mono); font-size: 8pt;
  }
  .ph h2 { font-size: 17pt; letter-spacing: -0.03em; }
  .ph-brand { margin-left: auto; display: inline-flex; align-items: center; gap: 7px; font-family: var(--font-display); font-weight: 600; font-size: 8.5pt; color: var(--ink) !important; }
  .pf {
    margin-top: auto; padding-top: 8px; border-top: 1px solid var(--border);
    display: flex; justify-content: space-between; gap: 12px; font-size: 7.5pt; color: var(--text-muted);
  }
  .pf a { color: var(--accent) !important; text-decoration: underline; text-underline-offset: 2px; }
  .lead-title { font-family: var(--font-display); font-weight: 650; font-size: 14pt; color: var(--ink); letter-spacing: -0.02em; line-height: 1.2; }
  .lead { font-size: 9pt; color: var(--text); margin: 4px 0 12px; max-width: none; }
  .k { font-size: 7pt; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #b4a8ff; }

  /* ── Cover ─────────────────────────────────────────────────────────── */
  .cover {
    padding: 16mm 16mm 13mm; color: var(--on-dark-muted); justify-content: space-between;
    background:
      radial-gradient(70% 45% at 100% 0%, rgba(139, 123, 255, 0.6), transparent 70%),
      radial-gradient(60% 40% at 0% 100%, rgba(111, 227, 255, 0.18), transparent 70%),
      var(--dark);
  }
  .cover-grid {
    position: absolute; inset: 0; pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 9mm 9mm;
    -webkit-mask-image: radial-gradient(ellipse 80% 55% at 70% 20%, #000 20%, transparent 80%);
    mask-image: radial-gradient(ellipse 80% 55% at 70% 20%, #000 20%, transparent 80%);
  }
  .cover > *:not(.cover-grid) { position: relative; }
  .cover-top { display: flex; align-items: center; justify-content: space-between; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: #fff !important; font-family: var(--font-display); font-weight: 650; font-size: 12pt; }
  .cover-tag { font-size: 7.5pt; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; padding: 5px 10px; border: 1px solid rgba(255, 255, 255, 0.18); border-radius: 999px; color: #fff; }
  .kicker { font-size: 8pt; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #b4a8ff; }
  .cover h1 { margin-top: 12px; color: #fff; font-size: 33pt; line-height: 1.03; letter-spacing: -0.04em; }
  .cover-sub { margin-top: 14px; font-size: 10pt; line-height: 1.55; max-width: 36em; }

  .bento { display: grid; grid-template-columns: repeat(6, 1fr); gap: 7px; margin: 0; }
  .bento > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 5px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.12); background: rgba(255, 255, 255, 0.045); }
  .bento .b-big {
    grid-column: span 3; padding: 14px 16px;
    background: radial-gradient(120% 120% at 100% 0%, rgba(139, 123, 255, 0.38), transparent 65%), rgba(255, 255, 255, 0.06);
    border-color: rgba(139, 123, 255, 0.45);
  }
  .b-small { grid-column: span 2; padding: 10px 12px; }
  .bento dd {
    margin: 0; font-family: var(--font-display); font-weight: 700; letter-spacing: -0.04em; line-height: 1; white-space: nowrap;
    background: linear-gradient(100deg, #e0daff, #9d8dff 55%, var(--glow-cyan)); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .b-big dd { font-size: 30pt; }
  .b-small dd { font-size: 16pt; }
  .b-big dt { font-size: 9pt; color: #e8e4ff; }
  .b-small dt { font-size: 7.3pt; line-height: 1.35; }
  .cover-foot { display: flex; flex-wrap: wrap; gap: 8px; }
  .cover-foot a {
    display: inline-flex; align-items: center; gap: 6px; padding: 6px 11px; border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.06);
    color: #fff !important; font-size: 8pt;
  }

  /* ── Capabilities ──────────────────────────────────────────────────── */
  .cap-groups { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .cap-group { padding: 12px 14px; border: 1px solid var(--border); border-radius: 12px; border-top-width: 3px; }
  .cg0 { border-top-color: var(--accent); }
  .cg1 { border-top-color: #8f6dff; }
  .cg2 { border-top-color: #3aa7f0; grid-column: 1 / -1; }
  .cg2 ul { grid-template-columns: 1fr 1fr; column-gap: 14px; }
  .cap-group h3 { font-size: 10.5pt; margin-bottom: 7px; display: flex; align-items: baseline; gap: 8px; }
  .cap-group h3 span { font-family: var(--font-sans); font-weight: 400; font-size: 7.8pt; color: var(--text-muted); }
  .cap-group ul { list-style: none; display: grid; gap: 8px; }
  .cap-group li { display: flex; gap: 9px; align-items: flex-start; font-size: 8.3pt; line-height: 1.42; }
  .cap-group li strong { display: block; color: var(--ink); font-size: 9.2pt; }
  .cap-icon { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 25px; height: 25px; border-radius: 7px; background: var(--accent-soft); color: var(--accent); }
  .why {
    margin-top: 12px; display: grid; grid-template-columns: 0.9fr 1.3fr; gap: 14px;
    padding: 14px 16px; border-radius: 12px; color: var(--on-dark-muted); font-size: 8pt;
    background: radial-gradient(100% 120% at 100% 0%, rgba(139, 123, 255, 0.35), transparent 60%), var(--dark);
  }
  .why h3 { color: #fff; font-size: 11.5pt; line-height: 1.2; margin: 4px 0 6px; }
  .why ul { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 14px; }
  .why li strong { display: block; color: #fff; font-size: 8.5pt; }
  .sectors { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; }
  .sectors div { padding: 9px 11px; border-radius: 10px; background: var(--surface); font-size: 7.8pt; line-height: 1.4; }
  .sectors strong { display: block; color: var(--ink); font-size: 8.8pt; margin-bottom: 2px; }
  .note { margin-top: 12px; padding: 10px 12px; border-radius: 10px; background: var(--accent-soft); font-size: 8.3pt; color: var(--ink); }

  /* ── Services ──────────────────────────────────────────────────────── */
  .svc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
  .svc { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
  .svc img { width: 100%; height: 36mm; object-fit: cover; object-position: top; border-bottom: 1px solid var(--border); background: var(--surface); }
  .svc-body { padding: 8px 11px 9px; display: flex; flex-direction: column; flex: 1; }
  .svc-k { display: inline-flex; align-items: center; gap: 5px; font-size: 7pt; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .svc h3 { margin-top: 3px; font-size: 10pt; line-height: 1.2; }
  .svc-t { margin-top: 3px; font-size: 7.8pt; line-height: 1.4; }
  .svc ul { margin: 4px 0 0 12px; font-size: 7.5pt; line-height: 1.35; color: var(--ink); flex: 1; }
  .more-row { margin-top: 4px; display: flex; flex-wrap: wrap; gap: 4px 12px; }
  .more.live { color: var(--ink) !important; text-decoration: underline; text-underline-offset: 2px; }
  .case-link { margin-top: 5px; align-self: flex-start; font-size: 8pt; font-weight: 600; color: var(--accent) !important; text-decoration: underline; text-underline-offset: 2px; }
  .more { font-size: 7.5pt; font-weight: 600; color: var(--accent) !important; }

  /* ── Work ──────────────────────────────────────────────────────────── */
  .cases { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
  .case { padding: 13px 15px; border: 1px solid var(--border); border-radius: 12px; display: flex; flex-direction: column; }
  .case:last-child { grid-column: 1 / -1; }
  .case-top { display: flex; align-items: baseline; gap: 8px; padding-bottom: 7px; border-bottom: 1px solid var(--border); }
  .case-metric {
    font-family: var(--font-display); font-weight: 700; font-size: 21pt; letter-spacing: -0.04em; line-height: 1; white-space: nowrap;
    background: linear-gradient(100deg, var(--accent), #8f6dff 50%, #3aa7f0); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .case-label { font-size: 7.5pt; color: var(--text-muted); line-height: 1.3; }
  .case-sector { margin-top: 7px; font-size: 7pt; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
  .case h3 { margin-top: 2px; font-size: 10.8pt; line-height: 1.25; }
  .case-body { margin-top: 4px; font-size: 8.4pt; line-height: 1.45; }
  .case-result { margin-top: auto; padding-top: 7px; font-size: 8.2pt; line-height: 1.45; color: var(--ink); }
  .case-result strong { color: var(--accent); }

  /* ── Process, approach, about, contact ─────────────────────────────── */
  .process { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 7px; }
  .process li { padding: 10px; border-radius: 10px; background: var(--surface); border-top: 3px solid var(--accent); }
  .p-n { font-family: var(--font-display); font-weight: 700; font-size: 14pt; color: var(--accent); }
  .p-when { display: block; font-size: 7pt; color: var(--text-muted); }
  .process h3 { margin-top: 5px; font-size: 9.5pt; }
  .process p { margin-top: 3px; font-size: 7.6pt; line-height: 1.4; }
  .sub-h { margin: 14px 0 7px; font-family: var(--font-display); font-weight: 650; font-size: 11pt; color: var(--ink); letter-spacing: -0.02em; }
  .approach { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; }
  .ap { padding: 10px; border-radius: 10px; background: var(--surface); font-size: 7.8pt; }
  .ap.dark { background: var(--dark); color: var(--on-dark-muted); }
  .ap.dark h3 { color: #fff; }
  .ap-tag { font-size: 6.8pt; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .ap.dark .ap-tag, .ap.dark .ap-tools { color: #b4a8ff; }
  .ap h3 { margin: 4px 0; font-size: 9.3pt; line-height: 1.25; }
  .ap-tools { margin-top: 5px; font-family: var(--font-mono); font-size: 6.6pt; color: var(--text-muted); }
  .about { display: grid; grid-template-columns: 22mm 1fr; gap: 12px; align-items: start; }
  .about img { width: 100%; height: 27mm; object-fit: cover; object-position: top; border-radius: 10px; }
  .about-lead { font-size: 8.8pt; color: var(--ink); }
