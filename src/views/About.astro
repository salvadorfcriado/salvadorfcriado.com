---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CTABand from '../components/CTABand.astro';
import { SITE } from '../consts';
import { copy } from '../i18n/site';
import { route } from '../i18n/routes';
import { otherLang, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = copy(lang);
const a = c.about;
const P_ICONS = ['target', 'chat', 'shield', 'layers'] as const;
const stats = c.home.stats;
---
<Base
  title={a.meta.title}
  description={a.meta.description}
  path={route(lang, 'about')}
  altPath={route(otherLang(lang), 'about')}
  lang={lang}
  current="about"
>
  <PageHero eyebrow={a.hero.eyebrow} title={a.hero.title} lead={a.hero.lead}>
    <div class="cta">
      <a class="btn btn-primary btn-lg" href={route(lang, 'contact')}>{c.common.contactCta}<Icon name="arrow" /></a>
      <a class="btn btn-glass btn-lg" href={route(lang, 'cv')}>{c.nav.cv}<Icon name="arrow" /></a>
    </div>
    <figure class="portrait" slot="visual">
      <img src="/img/portrait-390.webp" width="390" height="460" alt={a.hero.portraitAlt} fetchpriority="high" />
      <figcaption><span class="pill-dot" aria-hidden="true"></span>{c.home.hero.badge}</figcaption>
    </figure>
  </PageHero>

  <section class="section">
    <div class="container story">
      <h2 class="h2 reveal">{a.story.title}</h2>
      <div class="story-body reveal" data-delay="1">
        {a.story.paragraphs.map((p, i) => <p class:list={{ first: i === 0 }}>{p}</p>)}
      </div>
    </div>
    <div class="container">
      <dl class="stats">
        {stats.map((s, i) => (
          <div class="stat reveal" data-delay={String(i)}><dt>{s.l}</dt><dd>{s.n}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <SectionHeader title={a.timeline.title}>
        <a class="btn btn-secondary" href={route(lang, 'cv')}>{c.nav.cv}<Icon name="arrow" /></a>
      </SectionHeader>
      <ol class="timeline" role="list">
        {a.timeline.items.map((t, i) => (
          <li class="tl reveal" data-delay={String(Math.min(i, 3))}>
            <p class="tl-when">{t.when}</p>
            <div class="tl-dot" aria-hidden="true"></div>
            <div class="tl-body">
              <h3>{t.role}</h3>
              <p class="tl-org">{t.org}</p>
              <p>{t.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader title={a.principles.title} />
      <ul class="principles" role="list">
        {a.principles.items.map((p, i) => (
          <li class="card reveal" data-delay={String(i)}>
            <span class="icon-tile"><Icon name={P_ICONS[i]} /></span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--dark glow">
    <div class="container creds">
      <h2 class="h2">{a.credentials.title}</h2>
      <dl class="cred-list">
        {a.credentials.items.map((x) => (
          <div class="cred reveal"><dt>{x.k}</dt><dd>{x.v}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <div class="spacer"></div>
  <CTABand lang={lang} />
</Base>

<style>
  .portrait { position: relative; margin: 0 0 0 auto; max-width: 400px; }
  .portrait img { width: 100%; aspect-ratio: 390 / 460; height: auto; object-fit: cover; border-radius: var(--radius-lg); box-shadow: 0 40px 100px -30px rgba(0, 0, 0, 0.7); border: 1px solid rgba(255, 255, 255, 0.12); }
  .portrait figcaption {
    position: absolute; left: 16px; bottom: 16px; display: inline-flex; align-items: center; gap: 10px;
    padding: 9px 14px; border-radius: 999px; background: rgba(12, 11, 25, 0.82); color: #fff; font-size: var(--fs-xs); backdrop-filter: blur(8px);
  }

  .story { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .story-body { display: flex; flex-direction: column; gap: 20px; font-size: var(--fs-lg); line-height: 1.7; }
  .story-body .first { color: var(--ink); font-size: clamp(1.2rem, 1.1rem + 0.5vw, 1.45rem); line-height: 1.55; font-family: var(--font-display); letter-spacing: -0.01em; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin: clamp(56px, 7vw, 88px) 0 0; }
  .stat { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 8px; padding: 24px; border-radius: var(--radius-card); background: var(--surface); border: 1px solid var(--border); }
  .stat dd { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.9rem, 1.5rem + 1.5vw, 2.6rem); letter-spacing: -0.04em; line-height: 1; color: var(--accent); }
  .stat dt { font-size: var(--fs-sm); }

  .timeline { list-style: none; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 180px; top: 8px; bottom: 8px; width: 2px; background: linear-gradient(var(--accent), var(--accent-line) 60%, transparent); }
  .tl { display: grid; grid-template-columns: 160px 40px 1fr; align-items: start; padding: 0 0 36px; }
  .tl-when { font-family: var(--font-mono); font-size: var(--fs-xs); color: var(--text-muted); padding-top: 4px; }
  .tl-dot { width: 14px; height: 14px; margin: 5px 0 0 14px; border-radius: 50%; background: var(--bg); border: 3px solid var(--accent); }
  .tl-body h3 { font-size: var(--fs-h4); font-weight: 650; }
  .tl-org { color: var(--accent-strong); font-size: var(--fs-sm); font-weight: 500; margin: 2px 0 8px; }
  .tl-body p:last-child { max-width: 42em; }

  .principles { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .principles li { padding: 28px 24px; }
  .principles h3 { margin-top: 20px; font-size: var(--fs-h4); font-weight: 650; }
  .principles p { margin-top: 8px; font-size: var(--fs-sm); }

  .creds { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .cred-list { margin: 0; }
  .cred { display: grid; grid-template-columns: 180px 1fr; gap: 24px; padding: 18px 0; border-bottom: 1px solid var(--dark-border); }
  .cred dt { font-size: var(--fs-xs); font-weight: 600; letter-spacing: var(--tracking-label); text-transform: uppercase; color: #a99cff; padding-top: 3px; }
  .cred dd { margin: 0; color: #fff; font-weight: 500; }
  .spacer { height: clamp(48px, 6vw, 80px); }

  @media (max-width: 960px) {
    .portrait { margin: 0; max-width: 320px; }
    .story, .creds { grid-template-columns: 1fr; }
    .stats, .principles { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .timeline::before { left: 6px; }
    .tl { grid-template-columns: 28px 1fr; }
    .tl-when { grid-column: 2; grid-row: 1; padding: 0 0 6px; }
    .tl-dot { grid-column: 1; grid-row: 1 / span 2; margin: 2px 0 0 0; }
    .tl-body { grid-column: 2; }
    .cred { grid-template-columns: 1fr; gap: 6px; }
    .stats, .principles { grid-template-columns: 1fr; }
  }
</style>
