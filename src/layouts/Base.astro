---
import '../styles/global.css';
import { SITE, KNOWS_ABOUT } from '../consts';
import { UI, otherLang, type Lang } from '../i18n/ui';
import type { PageKey } from '../i18n/routes';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface ArticleMeta {
  publishedTime: string;
  modifiedTime?: string;
  tags?: readonly string[];
}

interface Props {
  title: string;
  description: string;
  path: string;
  /* Appended to `title` for the document title. Pass `false` on a page whose
     title already reads as a full one. */
  titleSuffix?: string | false;
  /* What social platforms show. Kept separate because they truncate around
     60–70 characters and the site-name suffix eats the payload — og:site_name
     already carries it. */
  ogTitle?: string;
  ogImage?: string;
  /* Cards are 1200×630. Declare the size so a crawler picks the large layout
     without having to fetch and decode the image first. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  article?: ArticleMeta;
  /* Emits robots noindex. For the error page and for archives too thin to rank. */
  noindex?: boolean;
  /* Legacy; the header is the same on every page now. */
  navSlot?: 'anchors' | 'back';
  /* Highlights the matching nav item. */
  current?: PageKey;
  jsonLd?: Record<string, unknown>[];
  lang?: Lang;
  /* The same page in the other language. Derived from `path` by adding or
     removing the /es prefix; pass it only when the twin lives elsewhere, or
     `false` when there is none. */
  altPath?: string | false;
}

const {
  title,
  description,
  path,
  titleSuffix = ` — ${SITE.name}`,
  ogTitle,
  ogImage,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageAlt,
  ogType = 'website',
  article,
  noindex = false,
  current,
  jsonLd = [],
  lang = 'en',
  altPath,
} = Astro.props;

const t = UI[lang];
const twinLang = otherLang(lang);
const twinPath = altPath ?? (lang === 'es' ? path.replace(/^\/es(?=\/)/, '') : `/es${path}`);
const enPath = lang === 'en' ? path : twinPath;
const esPath = lang === 'es' ? path : twinPath;
const feed = lang === 'es' ? '/es/rss.xml' : '/rss.xml';

const documentTitle = titleSuffix === false ? title : `${title}${titleSuffix}`;
const socialTitle = ogTitle ?? title;
const canonical = new URL(path, SITE.url).href;
/* Pages without a card of their own share the site card in their language. */
const ogPath = ogImage ?? `/img/og-${lang}.png`;
/* Absolute — a relative og:image is silently dropped by most unfurlers. */
const ogUrl = new URL(ogPath, SITE.url).href;
const imageAlt = ogImageAlt ?? socialTitle;

/* One Person node, cross-referenced by @id from every other node on the site.
   `alternateName` is deliberately absent: it is the property Google uses to
   build Knowledge Graph aliases, and the legal name is never rendered. */
const person = {
  '@type': 'Person',
  '@id': `${SITE.url}/#person`,
  name: SITE.name,
  givenName: 'Salvador',
  familyName: 'Criado',
  jobTitle: ['Applied AI Specialist', 'AI Engineer', 'Software Engineer', 'Platform Engineer'],
  description:
    'AI engineer and platform engineer in Granada, Spain, working remotely. Eight years shipping '
    + 'production systems; LLM applications, RAG, agentic systems and real-time voice on a backbone '
    + 'of AWS, Azure, Terraform and Kubernetes.',
  url: SITE.url,
  mainEntityOfPage: { '@id': `${SITE.url}/#profilepage` },
  image: {
    '@type': 'ImageObject',
    url: `${SITE.url}/img/portrait.webp`,
    width: 512,
    height: 512,
  },
  email: `mailto:${SITE.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.locality,
    addressRegion: SITE.region,
    addressCountry: SITE.country,
  },
  workLocation: [
    { '@type': 'Place', name: 'Granada, Spain' },
    { '@type': 'VirtualLocation', name: 'Remote (worldwide)' },
  ],
  knowsLanguage: [
    { '@type': 'Language', name: 'Spanish', alternateName: 'es' },
    { '@type': 'Language', name: 'English', alternateName: 'en' },
  ],
  hasOccupation: {
    '@type': 'Occupation',
    name: 'AI Engineer',
    /* O*NET-SOC — Software Developers. 15-2051.00 would read as data science
       instead; do not list both. */
    occupationalCategory: '15-1252.00',
    skills: KNOWS_ABOUT.join(', '),
    occupationLocation: {
      '@type': 'City',
      name: 'Granada',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Granada',
        addressRegion: 'Andalusia',
        addressCountry: 'ES',
      },
    },
  },
  /* What this entity offers. The site sells project work to businesses now;
     each service is the same one the landing page explains. */
  makesOffer: [
    'Voice AI agents',
    'Conversational AI agents',
    'AI document processing',
    'Invoice processing and bookkeeping automation',
    'Custom software development',
    'Cloud infrastructure and deployment on AWS and Azure',
  ].map((name) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name, provider: { '@id': `${SITE.url}/#person` } },
    areaServed: 'Worldwide',
  })),
  hasCredential: [
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'AWS Certified DevOps Engineer — Professional',
      credentialCategory: 'certification',
      recognizedBy: { '@type': 'Organization', name: 'Amazon Web Services' },
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Agentic AI',
      credentialCategory: 'certification',
      recognizedBy: { '@type': 'Organization', name: 'DeepLearning.AI' },
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Certified ScrumMaster (CSM)',
      credentialCategory: 'certification',
      recognizedBy: { '@type': 'Organization', name: 'Scrum Alliance' },
    },
  ],
  sameAs: [SITE.linkedin, SITE.github],
  knowsAbout: KNOWS_ABOUT,
};

const graph = { '@context': 'https://schema.org', '@graph': [person, ...jsonLd] };
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0c0b19" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {twinPath !== false && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(enPath as string, SITE.url).href} />
        <link rel="alternate" hreflang="es" href={new URL(esPath as string, SITE.url).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(enPath as string, SITE.url).href} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title={t.blog.title} href={feed} />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* No font preload, deliberately. The landing page's LCP element is the
        portrait, and preloading 68 KB of woff2 ahead of it pushed throttled LCP
        from 380 ms to 628 ms — measured, three runs, median. CLS was 0.0013 with
        or without, because the fallback faces above already hold the layout.
        Re-measure before adding it back. */}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.domain} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={t.ogLocale} />
    {twinPath !== false && <meta property="og:locale:alternate" content={UI[twinLang].ogLocale} />}
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        <meta property="article:modified_time" content={article.modifiedTime ?? article.publishedTime} />
        <meta property="article:author" content={SITE.linkedin} />
        {article.tags?.map((t) => <meta property="article:tag" content={t} />)}
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
    {/* Arms the scroll-reveal styles before first paint; without JS nothing is hidden. */}
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <Header lang={lang} twinPath={twinPath} current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      /* Three small behaviours, one observer each, all optional: the page is
         complete without them.
         1. .reveal elements fade in as they enter the viewport.
         2. Service clips play only while visible, never with reduced motion.
         3. The header turns solid once the page has scrolled. */
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reveals = document.querySelectorAll('.reveal');
      if (!still && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        reveals.forEach((el) => io.observe(el));

        const vio = new IntersectionObserver((entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) v.play().catch(() => {});
            else v.pause();
          }
        }, { threshold: 0.3 });
        document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => vio.observe(v));
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }

      const header = document.querySelector('[data-header]');
      const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      /* Close the mobile drawer when one of its links is followed (same-page anchors). */
      const drawer = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
      drawer?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) drawer.open = false;
      });
    </script>
  </body>
</html>

<style is:global>
  /* The skip link's target must not draw a focus ring of its own. */
  main:focus { outline: none; }
</style>
