---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import SectionHead from '../components/SectionHead.astro';
import { SITE } from '../consts';
import { tagLabel } from '../tags';
import { isoDay } from '../lib/format';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [featured, ...rest] = posts;
const next2 = rest.slice(0, 2);

const stats = [
  { n: '8+ yrs', c: 'systems in production' },
  { n: '<2.0s', c: 'voice loop, end to end' },
  { n: '100k+', c: "users on platforms i've run" },
  { n: '3', c: 'clouds: aws · azure · on-prem' },
];

const doing = [
  {
    t: 'LLM applications & agents',
    d: 'Hybrid RAG with reranking on Qdrant, agentic flows with tool calling against a live CRM, '
      + 'a Spanish voice loop under 2 s. In production, on client hardware.',
  },
  {
    t: 'Serving & evaluation',
    d: 'vLLM and NVIDIA Triton, quantisation with LLM Compressor, GuideLLM benchmarks, '
      + 'Langfuse tracing and golden-set regression gates.',
  },
  {
    t: 'The platform underneath',
    d: 'AWS to certified DevOps Pro level, Terraform, Kubernetes, event-driven pipelines and '
      + 'time-series at volume. Eight years of it.',
  },
];

const work = [
  {
    t: 'On-prem voice agents for an enterprise contact centre',
    d: "Agentic flows, RAG on Qdrant and a streaming voice loop under 2 s — on the client's own GPU, data never leaves the network.",
    y: '2025–26',
  },
  {
    t: 'Real-time telemetry platform for 1,000+ industrial sensors',
    d: 'Event-driven ingestion on AWS Lambda and IoT Core, time-series validation and routing, critical-event '
      + 'detection and alerting, plus an LLM layer answering questions over the live data. Took ownership after '
      + 'the team went from 20+ engineers to a handful.',
    y: '2024–25',
  },
  {
    t: 'AWS → Azure migration of a 100k-user e-learning platform',
    d: 'Multi-tenant Moodle/Laravel platform moving onto AKS: Terraform, Azure DevOps pipelines, '
      + 'tenant-by-tenant cutover. In progress.',
    y: '2026 — now',
  },
];

/* The experience data the CV removal took with it. HTML, not a PDF: indexable,
   one edit when career.md moves, and it cannot go stale behind a build step. */
const cvRows = [
  {
    k: 'Now',
    v: 'Independent consultant · AI & platform engineering — Sep 2025 to present. '
      + 'On-prem LLM voice, applied-AI bootstraps, and an AWS → Azure platform migration.',
  },
  {
    k: 'Before',
    v: 'Lead Software Engineer, industrial IoT data platform (2024–25) · Software Engineer, '
      + 'consulting — IaC, e-learning at scale, nuclear-plant alert filtering (2022–24) · '
      + 'Full-stack cloud & IoT (2018–22) · Postgraduate researcher, UPM (2017–18).',
  },
  {
    k: 'Education',
    v: 'MSc Electronic Systems, Universidad Politécnica de Madrid · '
      + 'BEng Telecommunications (Electronics), Universidad de Granada.',
  },
  {
    k: 'Certifications',
    v: 'AWS Certified DevOps Engineer – Professional · Agentic AI (DeepLearning.AI) · Certified ScrumMaster.',
  },
  {
    k: 'Languages',
    v: 'Spanish (native) · English (professional) · French (basic).',
  },
  {
    k: 'Stack',
    v: 'Python · TypeScript / Node.js · vLLM · Triton · Qdrant · Langfuse · AWS · Azure · '
      + 'Terraform · Kubernetes · Docker · PostgreSQL · MQTT.',
  },
];

const jsonLd = [
  /* ProfilePage is what Google documents for a page *about* one person; WebSite
     alone does not get that treatment. */
  {
    '@type': 'ProfilePage',
    '@id': `${SITE.url}/#profilepage`,
    url: `${SITE.url}/`,
    name: 'Salvador F. Criado — AI & Platform Engineer',
    mainEntity: { '@id': `${SITE.url}/#person` },
    isPartOf: { '@id': `${SITE.url}/#website` },
    inLanguage: 'en',
  },
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    description: 'AI & Platform Engineer — LLM applications, agents, real-time voice, and the cloud backbone underneath.',
    publisher: { '@id': `${SITE.url}/#person` },
    inLanguage: 'en',
  },
];
---
<Base
  title="Salvador F. Criado — AI & Platform Engineer"
  titleSuffix={false}
  ogTitle="Salvador F. Criado — AI Engineer & Platform Engineer"
  description="AI engineer and platform engineer in Granada, Spain, remote worldwide. LLM applications, agents and real-time voice, on a backbone of AWS, Terraform and Kubernetes. Open to permanent roles."
  path="/"
  jsonLd={jsonLd}
>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero graph-paper">
    <div class="wrap hero-grid">
      <div>
        <p class="label eyebrow">
          <span aria-hidden="true">[ </span>AI &amp; Platform Engineer — LLM apps · agents · distributed systems<span aria-hidden="true"> ]</span>
        </p>
        <h1 class="masthead">Salvador <br /><span class="accent">F. Criado</span></h1>
        <p class="lead">
          I build production AI end to end — agents, RAG and real-time voice, plus the GPU inference
          underneath. Eight years shipping distributed systems on AWS and Azure that stay up.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href={`mailto:${SITE.email}?subject=Role`}>{SITE.email}</a>
          <a class="btn btn-outline" href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
          <a class="btn btn-outline" href="/blog/">Field notes</a>
        </div>
        <p class="cta-note">remote worldwide · utc+1 · open to permanent senior / staff roles</p>
      </div>
      <figure class="portrait">
        <img
          src="/img/portrait-390.webp"
          width="390"
          height="460"
          alt="Salvador F. Criado, AI and platform engineer based in Granada, Spain"
          fetchpriority="high"
        />
        <figcaption>granada, es — utc+1</figcaption>
      </figure>
    </div>
  </section>

  <!-- ── Stat strip ───────────────────────────────────────────────────── -->
  <section class="strip">
    <div class="wrap strip-grid">
      {stats.map((s) => (
        <div class="cell"><span class="n">{s.n}</span><span class="c">{s.c}</span></div>
      ))}
    </div>
  </section>

  <!-- ── 01 / WHAT I DO ───────────────────────────────────────────────── -->
  <section class="section" id="what">
    <div class="wrap">
      <SectionHead index="01" title="What I do — AI engineering and platform work" />
      <div class="three">
        {doing.map((d) => (
          <div class="col"><h3>{d.t}</h3><p>{d.d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── 02 / SELECTED WORK ───────────────────────────────────────────── -->
  <section class="section alt" id="work">
    <div class="wrap">
      <SectionHead
        index="02"
        title="Selected work — production LLM and cloud systems"
        action={{ href: SITE.linkedin, label: 'full history on linkedin →', external: true }}
      />
      <ul class="rows" role="list">
        {work.map((w) => (
          <li class="work-row">
            <h3>{w.t}</h3>
            <p>{w.d}</p>
            <span class="year">{w.y}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── 03 / WRITING ─────────────────────────────────────────────────── -->
  <section class="section" id="writing">
    <div class="wrap">
      <SectionHead
        index="03"
        title="Writing"
        display="Field notes"
        action={{ href: '/blog/', label: 'ALL POSTS →', accent: true }}
      />
      <div class="writing-grid">
        {featured && (
          <div class="feature">
            <a href={`/blog/${featured.id}/`} tabindex="-1" aria-hidden="true">
              <Cover title={featured.data.title} tag={featured.data.tags[0]} variant="featured" />
            </a>
            <p class="meta">
              <time datetime={isoDay(featured.data.date)}>{isoDay(featured.data.date)}</time>
              {' · '}{featured.data.tags.map(tagLabel).join(' · ')}{' · '}{featured.data.readingTime} min
            </p>
            <h3 class="feature-title"><a href={`/blog/${featured.id}/`}>{featured.data.title}</a></h3>
            <p class="excerpt">{featured.data.excerpt}</p>
          </div>
        )}
        <div class="side">
          {next2.map((p) => (
            <div class="side-row">
              <a href={`/blog/${p.id}/`} tabindex="-1" aria-hidden="true">
                <Cover title={p.data.title} tag={p.data.tags[0]} variant="thumb" />
              </a>
              <div>
                <p class="meta">
                  <time datetime={isoDay(p.data.date)}>{isoDay(p.data.date)}</time>
                  {' · '}{tagLabel(p.data.tags[0])}{' · '}{p.data.readingTime} min
                </p>
                <h3 class="side-title"><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
              </div>
            </div>
          ))}
          <p class="rss-hint">
            New notes land in the <a href="/rss.xml">RSS feed</a>. No newsletter, no signup.
            Hiring? <a href={`mailto:${SITE.email}?subject=Role`}>{SITE.email}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 04 / ABOUT ───────────────────────────────────────────────────── -->
  <section class="section" id="about">
    <div class="wrap about-grid">
      <div>
        <SectionHead index="04" title="About — AI engineer in Granada, Spain, remote" />
        <p class="about-body">
          Hands-on engineer in Granada, Spain — remote worldwide. I started close to the metal, on PCBs and
          firmware, and worked up through distributed systems to platforms carrying a hundred thousand users.
          Applied AI is the newest layer on that stack, not a replacement for it: I still reach for Terraform
          and a profiler before I reach for a bigger model.
        </p>
        <p class="looking">
          <strong>What I'm looking for:</strong> a permanent, fully remote senior or staff role — applied AI
          on top of real platform work, or platform work that is about to need it. Hands-on by preference,
          happy to lead. EU national, no sponsorship needed in the EU, available worldwide within a workable
          timezone overlap.
        </p>
        <dl class="cv">
          {cvRows.map((r) => (
            <div class="cv-row">
              <dt>{r.k}</dt>
              <dd>{r.v}</dd>
            </div>
          ))}
        </dl>
        <div class="cta">
          <a class="btn btn-primary" href={`mailto:${SITE.email}?subject=Role`}>{SITE.email}</a>
          <a class="btn btn-outline" href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
        </div>
      </div>
      <div class="ambient graph-paper" aria-hidden="true"></div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { border-bottom: 1px solid var(--border); }
  .hero-grid {
    display: grid; grid-template-columns: 1fr 390px; gap: var(--space-gap-xl); align-items: start;
    padding: 64px var(--space-section-x) var(--space-gap-xl);
  }
  .eyebrow { margin-bottom: 18px; }
  .masthead {
    font-size: var(--text-masthead); font-weight: 700; line-height: 0.98;
    letter-spacing: var(--tracking-display); margin-bottom: 22px;
  }
  .accent { color: var(--accent); }
  .lead { font-size: var(--text-body-lg); line-height: 1.6; max-width: var(--measure); }
  .cta-note { font-family: var(--font-mono); font-size: var(--text-label); color: var(--text-muted); margin-top: 14px; }
  .portrait { position: relative; margin: 0; }
  /* portrait-390.webp is exactly 390×460, cropped from the 512×512 source.
     Never render it larger — it used to be scaled to 720×420 on tablet, a 1.4×
     upscale plus a 58% crop. A 2× source is still missing; see docs. */
  .portrait img {
    width: 100%; max-width: 390px; aspect-ratio: 390 / 460; height: auto; object-fit: cover;
    border-radius: var(--radius-img); background: var(--surface);
  }
  .portrait figcaption {
    position: absolute; left: 12px; bottom: 12px;
    background: var(--ink); color: var(--on-ink);
    font-family: var(--font-mono); font-size: var(--text-meta);
    padding: 6px 10px; border-radius: var(--radius-chip);
  }

  /* Stat strip — padding outside .wrap, matching TopBar and Footer. */
  .strip { border-bottom: 1px solid var(--border); padding: 0 var(--space-section-x); }
  .strip-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .cell {
    display: flex; flex-direction: column; gap: 4px;
    padding: 20px var(--space-gap-md) 20px 0;
    border-left: 1px solid var(--border);
    padding-left: var(--space-gap-md);
  }
  .cell:first-child { border-left: 0; padding-left: 0; }
  /* Display face, not mono — only one mono weight ships now. */
  .n { font-family: var(--font-display); font-weight: 700; font-size: var(--text-h2); color: var(--ink); }
  .c { font-family: var(--font-mono); font-size: var(--text-meta); color: var(--text-muted); }

  /* 01 */
  .three { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 28px; }
  .col { padding: 0 var(--space-gap-lg); border-left: 1px solid var(--border); }
  .col:first-child { border-left: 0; padding-left: 0; }
  .col h3 { font-size: var(--text-card-title); font-weight: 600; margin-bottom: var(--space-gap-sm); }
  .col p { font-size: var(--text-body); line-height: 1.6; max-width: var(--measure); }

  /* 03 */
  .writing-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: 36px; margin-top: 28px; }
  .feature-title { font-size: var(--text-h2); font-weight: 700; letter-spacing: var(--tracking-tight); margin: var(--space-gap-sm) 0; }
  .feature-title a:hover, .feature-title a:focus-visible,
  .side-title a:hover, .side-title a:focus-visible { color: var(--accent); }
  .meta { font-family: var(--font-mono); font-size: var(--text-label); color: var(--text-muted); margin-top: 14px; }
  .excerpt { font-size: var(--text-body); max-width: var(--measure); }
  .side { display: flex; flex-direction: column; gap: 22px; }
  .side-row { display: flex; gap: var(--space-gap); align-items: flex-start; }
  .side-row .meta { margin-top: 0; }
  .side-title { font-size: var(--text-card-title); font-weight: 600; line-height: 1.3; margin-top: 6px; }
  .rss-hint {
    border: 1px dashed var(--border-strong); border-radius: 8px; padding: 14px 16px;
    font-family: var(--font-mono); font-size: var(--text-label); line-height: 1.6;
    max-width: var(--measure);
  }
  .rss-hint a { color: var(--accent); text-decoration: underline; }

  /* 04 */
  .about-grid { display: grid; grid-template-columns: 1fr 380px; gap: var(--space-gap-xl); align-items: start; }
  .about-body { font-size: var(--text-body-md); line-height: 1.7; max-width: var(--measure); margin-top: 18px; }
  .looking {
    font-size: var(--text-body-md); line-height: 1.7; max-width: var(--measure);
    margin-top: var(--space-gap); padding-left: var(--space-gap);
    border-left: 3px solid var(--accent);
  }
  .looking strong { color: var(--ink); }
  .cv { margin: 28px 0 0; max-width: var(--measure); }
  .cv-row {
    display: grid; grid-template-columns: 110px 1fr; gap: var(--space-gap);
    padding: 10px 0; border-top: 1px solid var(--border);
  }
  .cv dt {
    font-family: var(--font-mono); font-size: var(--text-label);
    letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--accent);
  }
  .cv dd { margin: 0; font-size: var(--text-body); line-height: 1.6; }
  .ambient {
    height: 240px; border-radius: var(--radius-card);
    background-color: var(--surface);
    border: 1px solid var(--border);
  }

  /* Responsive */
  @media (max-width: 1180px) {
    .hero-grid { grid-template-columns: 1fr 320px; }
  }
  @media (max-width: 960px) {
    .hero-grid, .about-grid { grid-template-columns: 1fr; gap: var(--space-gap-lg); }
    .portrait img { max-width: 320px; }
    .strip-grid { grid-template-columns: repeat(2, 1fr); }
    .cell:nth-child(3) { border-left: 0; padding-left: 0; }
    .cell:nth-child(n+3) { border-top: 1px solid var(--border); }
    .writing-grid { grid-template-columns: 1fr; gap: var(--space-gap-md); }
    /* Empty 720×240 bordered box above the footer once it goes full-width. */
    .ambient { display: none; }
  }
  /* The three-up used to collapse straight to one column here, which put 13.5px
     body copy on a 720–912px line — 107 to 135 characters. */
  @media (min-width: 621px) and (max-width: 960px) {
    .three { grid-template-columns: repeat(2, 1fr); row-gap: var(--space-gap-md); }
    .col:nth-child(odd) { border-left: 0; padding-left: 0; }
  }
  @media (max-width: 620px) {
    .three { grid-template-columns: 1fr; gap: var(--space-gap-md); }
    .col { border-left: 0; padding: 0; }
  }
  @media (max-width: 560px) {
    .strip-grid { grid-template-columns: 1fr; }
    .cell { border-left: 0; padding-left: 0; border-top: 1px solid var(--border); }
    .cell:first-child { border-top: 0; }
    .side-row { flex-direction: column; }
    .cv-row { grid-template-columns: 1fr; gap: 4px; }
  }
  @media (max-width: 760px) {
    /* Standalone title links were 22px tall — under the 24px minimum. */
    .side-title a, .feature-title a { display: inline-block; padding: 6px 0; }
  }
</style>
