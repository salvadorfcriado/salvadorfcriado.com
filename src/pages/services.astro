---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';

/* Commercial surface. Deliberately OUT of the main navigation (services-surface spec):
   reachable from scdap.es and direct links, never from the hiring-facing pages. */

const fit = [
  {
    n: '/01',
    who: 'Agencies & mid-to-large companies',
    head: 'You closed a technical deal. You need a senior signature.',
    body: "Sales closed it. The technical part — IoT, cloud, AI, data — needs a profile you don't have in-house, and hiring takes months. I drop in as a senior architect, white-label if needed, and ship. Your team keeps the relationship.",
    tags: ['Senior signature', 'White-label option', 'Standard NDA, ES invoicing', 'Clean handover'],
  },
  {
    n: '/02',
    who: 'Startups, founders & greenfield',
    head: "You're going from idea to product. You need ownership.",
    body: "You're not looking for a freelancer waiting for tickets. You need someone who takes the technical call, brings momentum, and ships. I design the architecture, lay the foundations, and move product from day one. Founding-engineer mindset, not hourly consultant.",
    tags: ['End-to-end ownership', 'Momentum from day one', 'Decisions with judgment'],
  },
];

const services = [
  { n: '/01', t: 'Cloud architecture that scales without surprises',
    d: "So your system grows without the AWS bill becoming a surprise. Serverless, IaC with Terraform and real observability. Legacy modernisation with a plan, not a sledgehammer.",
    s: ['AWS Lambda', 'Terraform', 'K8s', 'Multi-cloud'] },
  { n: '/02', t: 'Data pipelines at your volume',
    d: "When data arrives faster than your team can process it. I've moved 1,000+ IoT sensors and 10,000 signals/sec in industrial. Time series, MQTT, BLE and data lakes that actually feed BI.",
    s: ['MQTT', 'IoT Core', 'Glue', 'Athena', 'Streaming'] },
  { n: '/03', t: 'AI that actually ships to production',
    d: "Cost, guardrails and observability under control. RAG with Bedrock + Claude, vLLM with Mistral on-prem if data can't leave the building, conversational voice under 2 s, and document OCR. Metrics, not slides.",
    s: ['Bedrock', 'Claude', 'vLLM', 'RAG', 'Qdrant'] },
  { n: '/04', t: 'Agent-driven delivery, at production standards',
    d: 'I design the supervision infrastructure that lets coordinated autonomous agents ship product end to end: task contracts, review checkpoints, persistent memory and automatic validations.',
    s: ['Claude Code', 'Multi-agent', 'Langfuse', 'n8n'] },
  { n: '/05', t: 'Backend your team can extend',
    d: 'APIs and services without toy abstractions. Node.js, NestJS, Python, Next.js. Clear contracts, third-party integrations, auth, queues and async processing. Databases without religion.',
    s: ['NestJS', 'Python', 'Next.js', 'PostgreSQL'] },
  { n: '/06', t: 'A second opinion with judgment',
    d: 'When stakes are high and you need someone who signs off. Architecture design and review, technical due diligence before signing, help estimating right. Hourly, retainer or project.',
    s: ['Review', 'Due diligence', 'Mentoring'] },
];

const process = [
  { n: '/01 · Diagnosis', t: 'A 30–60 min call', when: 'Free · no strings',
    d: "I understand the problem, context and real constraints. If I'm not the right fit, I'll say so and point you somewhere useful. You walk away with judgment either way." },
  { n: '/02 · Proposal', t: 'Architecture & estimate', when: '3–7 days · concrete deliverable',
    d: "Technical design, an honest estimate, alternatives with their trade-offs. We review it together. If the smart path doesn't involve me, I'll tell you that too." },
  { n: '/03 · Delivery', t: 'Build & handover', when: 'Per project · retainer · hourly',
    d: "Build with observability, useful documentation and a clean handover. You're left with the solution, not a dependency. I stay reachable if anything comes up." },
];

const jsonLd = [{
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/services/#service`,
  name: 'SCDAP — software and applied AI consulting',
  url: `${SITE.url}/services/`,
  provider: { '@id': `${SITE.url}/#person` },
  areaServed: 'Worldwide',
  address: { '@type': 'PostalAddress', addressLocality: SITE.locality, addressCountry: SITE.country },
  inLanguage: 'en',
}];
---
<Base
  title="Consulting — SCDAP | Cloud, data and applied AI, shipped to production"
  description="Senior architecture and delivery for agencies, scale-ups and founders: cloud, data pipelines and applied AI taken to production. Granada, Spain — remote worldwide."
  path="/services/"
  navSlot="back"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap inner">
      <p class="label">SCDAP — Consulting</p>
      <h1>You tell me what.<br /><span class="accent">I'll handle the how.</span></h1>
      <p class="lead">
        Senior software architect. Eight years putting production systems online — cloud, data, IoT,
        applied AI. For agencies, scale-ups and founders that need real ownership, not billed hours.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href={`mailto:${SITE.email}?subject=Project%20enquiry`}>Book a 30 min call — free</a>
        <span class="cta-note">granada · remote-first · &lt; 24 h reply · standard nda · es invoicing</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="label">01 / Who this is for</p>
      <p class="sec-lead">
        Two contexts where I fit well. If you recognise yours, let's talk. If not, I'll say so on the first call.
      </p>
      <div class="two">
        {fit.map((f) => (
          <div class="card">
            <p class="num">{f.n} · {f.who}</p>
            <h2>{f.head}</h2>
            <p class="body">{f.body}</p>
            <ul class="tags">{f.tags.map((t) => <li>{t}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <p class="label">02 / Services</p>
      <p class="sec-lead">
        I come in as architect, as implementer, or as both. What I always deliver: documented architecture
        your team extends — not dependency on me.
      </p>
      <div class="three">
        {services.map((s) => (
          <div class="svc">
            <p class="num">{s.n}</p>
            <h3>{s.t}</h3>
            <p class="body">{s.d}</p>
            <ul class="chips">{s.s.map((x) => <li>{x}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="label">03 / How I work</p>
      <p class="sec-lead">
        Three steps, no surprises. You know exactly what happens after the next call — the risk of getting
        started drops to zero.
      </p>
      <ol class="steps">
        {process.map((p) => (
          <li>
            <p class="num">{p.n}</p>
            <h3>{p.t}</h3>
            <p class="when">{p.when}</p>
            <p class="body">{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <p class="label">04 / Selected work</p>
      <p class="sec-lead">In production, right now. Details, metrics and references under NDA on request.</p>
      <ul class="rows">
        <li class="row">
          <h3>AI call-centre with real-time voice</h3>
          <p class="body">End-to-end automation. Local LLM for private data, agentic orchestration of flows, and a conversational voice loop under 2 s end to end — on the client's own hardware.</p>
          <span class="year">2025—26</span>
        </li>
        <li class="row">
          <h3>AWS → Azure migration, 100k-user platform</h3>
          <p class="body">Multi-tenant e-learning platform lifted onto AKS: Terraform, Azure DevOps pipelines, and a cutover with the service staying up.</p>
          <span class="year">2026</span>
        </li>
        <li class="row">
          <h3>Industrial IoT data platform</h3>
          <p class="body">1,000+ sensors, 10,000 signals/sec, real-time alerting and a conversational layer over the telemetry.</p>
          <span class="year">2023—25</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section closing">
    <div class="wrap">
      <h2 class="close-h">Tell me the problem. I'll tell you if I'm the right fit.</h2>
      <div class="cta">
        <a class="btn btn-primary" href={`mailto:${SITE.email}?subject=Project%20enquiry`}>{SITE.email}</a>
        <a class="btn btn-outline" href={SITE.linkedin} rel="noopener" target="_blank">LinkedIn</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    border-bottom: 1px solid var(--border);
    background-color: var(--bg);
    background-image:
      repeating-linear-gradient(to right, var(--grid-line) 0 1px, transparent 1px var(--grid-cell)),
      repeating-linear-gradient(to bottom, var(--grid-line) 0 1px, transparent 1px var(--grid-cell));
  }
  .inner { padding: 64px var(--space-section-x) 56px; }
  .inner h1 {
    font-size: 56px; font-weight: 700; line-height: 1.02;
    letter-spacing: var(--tracking-display); margin: 16px 0 20px; max-width: 15ch;
  }
  .accent { color: var(--accent); }
  .lead { font-size: var(--text-body-lg); line-height: 1.6; max-width: 560px; }
  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-gap); margin-top: 28px; }
  .cta-note { font-family: var(--font-mono); font-size: var(--text-label); color: var(--text-muted); }

  .alt { background: var(--surface); }
  .sec-lead { font-size: 15px; line-height: 1.7; max-width: 620px; margin-top: 14px; }
  .num {
    font-family: var(--font-mono); font-size: var(--text-label);
    letter-spacing: var(--tracking-label); color: var(--accent); text-transform: uppercase;
  }
  .body { font-size: var(--text-body-sm); line-height: 1.65; }

  .two { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-gap-lg); margin-top: 32px; }
  .card { border: 1px solid var(--border); border-radius: var(--radius-card); padding: 26px 28px; background: var(--bg); }
  .card h2 { font-size: 19px; font-weight: 600; letter-spacing: var(--tracking-tight); margin: 10px 0 12px; }
  .tags { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li {
    font-family: var(--font-mono); font-size: var(--text-meta);
    border: 1px solid var(--border-strong); border-radius: var(--radius-chip); padding: 4px 8px;
  }

  .three { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-gap-lg); margin-top: 32px; }
  .svc h3 { font-size: var(--text-card-title); font-weight: 600; margin: 10px 0 10px; }
  .chips { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .chips li {
    font-family: var(--font-mono); font-size: var(--text-meta);
    background: var(--accent-soft); color: var(--accent-strong);
    border-radius: var(--radius-chip); padding: 4px 8px;
  }

  .steps { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-gap-lg); }
  .steps h3 { font-size: var(--text-card-title); font-weight: 600; margin: 10px 0 4px; }
  .when { font-family: var(--font-mono); font-size: var(--text-meta); color: var(--text-muted); margin-bottom: 10px; }

  .rows { list-style: none; margin: 28px 0 0; padding: 0; }
  .row {
    display: grid; grid-template-columns: 1fr 1.5fr 120px; gap: var(--space-gap-lg);
    padding: 20px 0; border-top: 1px solid var(--border); align-items: baseline;
  }
  .row h3 { font-size: 16px; font-weight: 600; }
  .year { font-family: var(--font-mono); font-size: var(--text-label); text-align: right; color: var(--text-muted); }

  .closing { border-bottom: 0; }
  .close-h { font-size: var(--text-h2); font-weight: 700; letter-spacing: var(--tracking-tight); max-width: 20ch; }
  .closing .cta { margin-top: 22px; }

  @media (max-width: 960px) {
    .inner h1 { font-size: 38px; }
    .two, .three, .steps { grid-template-columns: 1fr; }
    .row { grid-template-columns: 1fr; gap: 6px; }
    .year { text-align: left; }
  }
</style>
