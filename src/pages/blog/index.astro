---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import TagChips from '../../components/TagChips.astro';
import { SITE, BLOG } from '../../consts';
import { sortByVocabulary } from '../../tags';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

/* Chips come from the posts, not from the vocabulary — a tag nothing carries
   gets no archive page, so nothing may link to one. */
const tagsInUse = sortByVocabulary([...new Set(posts.flatMap((p) => p.data.tags))]);

const jsonLd = [
  {
    '@type': 'Blog',
    '@id': `${SITE.url}/blog/#blog`,
    name: BLOG.name,
    description: BLOG.description,
    url: `${SITE.url}/blog/`,
    author: { '@id': `${SITE.url}/#person` },
    inLanguage: 'en',
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${SITE.url}/blog/#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: BLOG.name },
    ],
  },
];
---
<Base
  title={BLOG.name}
  ogTitle={BLOG.name}
  description={BLOG.description}
  path="/blog/"
  navSlot="back"
  jsonLd={jsonLd}
>
  <section class="masthead-lite graph-paper">
    <div class="wrap inner">
      <p class="label">Writing</p>
      <h1>{BLOG.name}</h1>
      <p class="sub">
        What breaks when an LLM system meets production, and the order to fix it in.
        <a href="/rss.xml">Subscribe by RSS</a>.
      </p>
      <nav class="filters" aria-label="Filter by topic">
        <TagChips tags={tagsInUse} />
      </nav>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <ul class="post-rows" role="list">
        {posts.map((p) => <PostRow post={p} />)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .masthead-lite { border-bottom: 1px solid var(--border); padding: 0 var(--space-section-x); }
  .inner { padding: var(--space-gap-xl) 0 44px; }
  .inner h1 {
    font-size: var(--text-h1-lg); font-weight: 700; letter-spacing: var(--tracking-display);
    line-height: 1; margin: 14px 0 12px;
  }
  .sub { font-size: var(--text-body-lg); max-width: var(--measure); }
  .sub a { color: var(--accent); text-decoration: underline; }
  .filters { margin-top: 26px; }
  .post-rows { list-style: none; margin: 0; padding: 0; }
  .post-rows li { border-top: 1px solid var(--border); }
  .post-rows li:first-child { border-top: 0; }
  @media (max-width: 620px) {
    .inner h1 { font-size: var(--text-h1); }
  }
</style>
