# Copy to agent/.env and fill in. agent/.env is git-ignored and must stay that way.
# Nothing in this file is required to run the pipeline as the repository owner:
# the default backend is Claude Code headless, under an existing subscription.

# ── Backend selection ───────────────────────────────────────────────────────
# One of: claude_code | api | mock. Overrides the default for every stage; the
# per-stage map lives in agent/config.py (STAGE_BACKENDS).
AGENT_DEFAULT_BACKEND=claude_code

# ── Claude Code headless backend ────────────────────────────────────────────
# The binary invoked as `claude -p`. Only set this if it is not on PATH.
# AGENT_CLAUDE_BINARY=claude

# ── Hosted API backend ──────────────────────────────────────────────────────
# The documented fallback, so someone who clones this repository can run the
# pipeline with their own credentials. Set AGENT_DEFAULT_BACKEND=api to use it.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# AGENT_API_MODEL=claude-sonnet-4-5
